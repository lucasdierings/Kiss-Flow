{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kissflow",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-05",
  // nodejs_compat é obrigatória para o @opennextjs/cloudflare
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kissflow",
      "database_id": "e96aa979-bea5-4874-ae06-d40b8a8f45cb",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "kissflow-media"
    }
  ],
  "observability": {
    "enabled": true
  }
}
