{
  "expo": {
    "name": "Kiss Flow",
    "slug": "kissflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kissflow",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kissflow.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "O Kiss Flow precisa de acesso à galeria para enviar capturas de tela ao seu mentor de inteligência comportamental.",
        "NSCameraUsageDescription": "Permite fotografar para salvar o avatar do alvo ou registrar prints."
      }
    },
    "android": {
      "package": "com.kissflow.app",
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0D0D0D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0D0D0D"
        }
      ],
      "expo-share-intent"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
